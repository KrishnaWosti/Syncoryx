# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git. Never commit real credentials.

# Database (popup settings, subscribers, editable copy, contact messages)
MONGODB_URI=mongodb://localhost:27017/syncoryx

# Email alerts for contact form messages (optional).
# Leave SMTP_HOST empty to switch alerts off. Messages are still saved
# to the database and listed in /admin under Messages.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional. The "From" address on the alert. Defaults to SMTP_USER.
SMTP_FROM=
# Optional. Where alerts are delivered. Defaults to contact@syncoryx.agency.
CONTACT_NOTIFY_TO=
